{
  "name": "rein",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src e2e scripts/check-migrations.mjs scripts/check-secrets.mjs scripts/check-tutoring-boundaries.mjs package.json pnpm-workspace.yaml",
    "format:check": "prettier --check src e2e scripts/check-migrations.mjs scripts/check-secrets.mjs scripts/check-tutoring-boundaries.mjs package.json pnpm-workspace.yaml",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "spec:coverage": "node scripts/check-spec-coverage.mjs",
    "spec:verify": "node scripts/verify-pack.mjs",
    "migrations:check": "node scripts/check-migrations.mjs",
    "tutoring:check": "node scripts/check-tutoring-boundaries.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:link:rein": "supabase link --project-ref iuyutpgehoalxbhjokqe",
    "db:push:dry": "supabase db push --dry-run",
    "db:push:remote": "supabase db push",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm migrations:check && pnpm tutoring:check && pnpm secrets:check && pnpm build && pnpm spec:verify && pnpm test:e2e",
    "verify:db": "pnpm db:lint && pnpm db:test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.6",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
