# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=REIN
APP_LOCALE=ko-KR
APP_CURRENCY=KRW
APP_TIMEZONE=Asia/Seoul
DEMO_MODE=true
SESSION_SECRET=

# Supabase — service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Google Calendar / Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ID=primary

# Banking provider: mock | manual_csv | kftc_testbed | kftc_production
BANK_PROVIDER=mock
KFTC_TESTBED_BASE_URL=
KFTC_PRODUCTION_BASE_URL=
KFTC_CLIENT_ID=
KFTC_CLIENT_SECRET=
KFTC_REDIRECT_URI=http://localhost:3000/api/integrations/banking/callback
KFTC_PRODUCTION_ENABLED=false

# RAINY (Groq) — reference only; the app doesn't read this. The key you paste into
# Settings > RAINY·GROQ is encrypted into a session cookie instead.
GROQ_API_KEY=

# Scheduled jobs / webhooks
CRON_SECRET=
WEBHOOK_SIGNING_SECRET=

# Logging / observability
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# GITHUB_PAT_TOKEN is read by Codex MCP from the shell; never put it here.
